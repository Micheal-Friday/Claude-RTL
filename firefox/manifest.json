{
  "manifest_version": 2,
  "name": "Claude & ChatGPT RTL (Persian & Arabic)",
  "version": "1.1.1",
  "description": "Automatic Persian and Arabic RTL support for Claude and ChatGPT. Keeps code and math left-to-right.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-rtl-persian-arabic-V2@addons",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Claude & ChatGPT RTL",
    "default_icon": {
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
